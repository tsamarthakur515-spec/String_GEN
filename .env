# ====================== TELEGRAM API ======================
TELEGRAM_API_ID=12345678          # apna Telegram API_ID daal
TELEGRAM_API_HASH=your_api_hash_here   # apna API_HASH daal

# ====================== BOT TOKEN ======================
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # @BotFather se lo

# ====================== SESSION ======================
SESSION_NAME=james_session        # .session file ka naam

# ====================== ENVIRONMENT ======================
ENVIRONMENT=production            # production / development

# ====================== LOGGER ======================
LOG_OWNER_ID=8841848847          # apna owner ID (main tu 8841848847 daal diya hai)
LOG_CHANNEL_ID=-1004318913888    # apna channel ID (main tu -1004318913888 daal diya hai)
